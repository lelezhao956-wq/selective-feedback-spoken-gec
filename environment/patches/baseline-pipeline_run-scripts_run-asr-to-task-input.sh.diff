# Portability patch to the official Speak & Improve Challenge 2025 baseline (distributed with the
# Speak & Improve Corpus 2025 data set; file headers "Copyright: S&I Challenge 2024", no licence stated).
# Because the licence of the official code is not stated, this diff has zero context lines (diff -U0): it holds only the
# changed lines (old line(s) "-", our replacement(s) "+"), not the surrounding official code. Apply to the unmodified file
# from the official zip: patch -p0 -b < <this file>   (patch ignores these header lines). The "-" lines remain the
# property of their owner; only the "+" lines are our work (CC BY 4.0).
--- ./baseline-pipeline/run-scripts/run-asr-to-task-input.sh.orig
+++ ./baseline-pipeline/run-scripts/run-asr-to-task-input.sh
@@ -117 +117 @@
-       --output_ctm $pre_norm_ctm |& tee $log_dir/select_files.$task.log
+       --output_ctm $pre_norm_ctm 2>&1 | tee $log_dir/select_files.$task.log
@@ -130 +130 @@
-	   --output_ctm $pre_norm_phrase_ctm |& tee $log_dir/add_phrase_markers.$task.log
+	   --output_ctm $pre_norm_phrase_ctm 2>&1 | tee $log_dir/add_phrase_markers.$task.log
@@ -149 +149 @@
-       --task $task |& tee $log_dir/ctm_norm.$task.log
+       --task $task 2>&1 | tee $log_dir/ctm_norm.$task.log
